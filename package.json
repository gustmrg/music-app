{
  "name": "cloud-music-desktop",
  "version": "0.0.0",
  "description": "Desktop music player for your local files, torrents from your own indexer, and YouTube.",
  "homepage": "https://github.com/gustmrg/music-app#readme",
  "author": "Gustavo Miranda",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && node scripts/build-electron.mjs --watch\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview",
    "start": "npm run dev",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test \"electron/*.test.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.468.0",
    "music-metadata": "~12.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.cloudmusic.desktop",
    "productName": "Local Music",
    "artifactName": "local-music-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Gustavo Miranda",
      "synopsis": "Player for your local music and playlists."
    }
  }
}
